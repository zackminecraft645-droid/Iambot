-- AutoGrab System (Fixed and Enhanced)
local AutoGrab = {
   processedPrompts = {},
   range = 10,
   enabled = true
}

function AutoGrab.processProximityPrompt(prompt)
    if not prompt:IsA("ProximityPrompt") then return end
    if AutoGrab.processedPrompts[prompt] then return end

    pcall(function()
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = math.max(prompt.MaxActivationDistance, AutoGrab.range)
        AutoGrab.processedPrompts[prompt] = true
    end)
end

function AutoGrab.initialize()
    -- Process existing prompts
    for _, descendant in pairs(game:GetService("Workspace"):GetDescendants()) do
        if descendant:IsA("ProximityPrompt") then
            AutoGrab.processProximityPrompt(descendant)
        end
    end

    -- Process new prompts
    game:GetService("Workspace").DescendantAdded:Connect(function(descendant)
        task.wait(0.1)
        AutoGrab.processProximityPrompt(descendant)
    end)
end

