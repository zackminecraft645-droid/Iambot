    Flag = "PromptRange",
    Callback = function(Value)
        AutoGrab.range = Value
        -- Update existing prompts
        for prompt, _ in pairs(AutoGrab.processedPrompts) do
            if prompt and prompt.Parent then
                pcall(function()
                    prompt.MaxActivationDistance = Value
                end)
            end
        end
    end
})

