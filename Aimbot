-- Fixed Noclip Toggle
local NoclipToggle = MainTab:CreateToggle({
   Name = "Noclip",
   CurrentValue = false,
   Flag = "NoclipToggle",
   Callback = function(Value)
      noclipEnabled = Value
      
      if noclipEnabled then
         -- Start noclip
         local function noclipLoop()
            if noclipEnabled and game.Players.LocalPlayer.Character then
               for _, v in pairs(game.Players.LocalPlayer.Character:GetDescendants()) do
                  if v:IsA("BasePart") and v.CanCollide and v.Name ~= "HumanoidRootPart" then
                     v.CanCollide = false
                  end
               end
            end
         end
         currentNoclipConnection = game:GetService("RunService").Stepped:Connect(noclipLoop)
      else
         -- Stop noclip
         if currentNoclipConnection then
            currentNoclipConnection:Disconnect()
            currentNoclipConnection = nil
         end
         -- Re-enable collision
         if game.Players.LocalPlayer.Character then
            for _, v in pairs(game.Players.LocalPlayer.Character:GetDescendants()) do
               if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
                  v.CanCollide = true
               end
            end
         end
      end
   end
})

