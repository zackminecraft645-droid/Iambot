      player.CharacterAdded:Connect(function(char)
          task.wait(1) -- Wait for character to fully load
          removeDetector(char)
      end)
      
      Rayfield:Notify({
         Title = "Anti-Detector",
         Content = "NoclipDetector removal activated!",
